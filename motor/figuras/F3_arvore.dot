digraph G {
  graph [rankdir=TB, nodesep=0.30, ranksep=0.26, fontname="Liberation Serif", dpi=300,
         newrank=true, pad=0.05];
  node  [fontname="Liberation Serif", fontsize=11, penwidth=0.9, margin="0.14,0.07",
         width=2.35, fontcolor="#1d1d1b"];
  edge  [fontname="Liberation Serif", fontsize=10, arrowsize=0.55, penwidth=0.8,
         color="#5f5d58", fontcolor="#3d3c39"];
  q1 [shape=box, style="rounded", color="#5f5d58", fillcolor="white", label="O titular tem\nmotivo de legado?"];
  g  [shape=box, style="rounded,filled", color="#b9b7b0", fillcolor="#f3f2ef", label=<<B>Caso-limite G</B><BR/>Instrumento racional: renda vitalícia.<BR/>Seguro sem função sucessória.>];
  q2 [shape=box, style="rounded", color="#5f5d58", fillcolor="white", label="Quem suporta a obrigação\nno óbito?"];
  h  [shape=box, style="rounded,filled", color="#2a78d6", penwidth=1.6, fillcolor="#e8f1fb", label=<<B>Cenário H · haveres</B><BR/>Na fronteira: pagamento direto<BR/>e <B>seguro temporário</B>.<BR/>Vitalício dominado, salvo sem<BR/>parcelamento e sem crédito.>];
  q3 [shape=box, style="rounded", color="#5f5d58", fillcolor="white", label="O VGBL é aplicável\nao perfil?"];
  bf [shape=box, style="rounded,filled", color="#b9b7b0", fillcolor="#f3f2ef", label=<<B>Cenários B e F</B><BR/>VGBL domina (taxa de<BR/>administração até 2,9% a.a.).>];
  q4 [shape=box, style="rounded", color="#5f5d58", fillcolor="white", label="O titular é contratável\nem condição padrão?"];
  e  [shape=box, style="rounded,filled", color="#b9b7b0", fillcolor="#f3f2ef", label=<<B>Cenário E · idade e agravo</B><BR/>Na fronteira: holding e doação.<BR/>Seguro fora em todas as classes.>];
  q5 [shape=box, style="rounded", color="#5f5d58", fillcolor="white", label="Patrimônio empresarial\nde grande porte?"];
  cd [shape=box, style="rounded,filled", color="#b9b7b0", fillcolor="#f3f2ef", label=<<B>Cenários C e D</B><BR/>Na fronteira: holding (regime 2026).<BR/>Seguro entra em C sem crédito-ponte<BR/>ou no regime pós-2027.>];
  a  [shape=box, style="rounded,filled", color="#2a78d6", penwidth=1.6, fillcolor="#e8f1fb", label=<<B>Cenário A</B><BR/>Na fronteira: inventário,<BR/><B>seguro</B> e doação. Escolha pela<BR/>aversão ao risco de cauda.>];
  ca [shape=note, style="filled", fillcolor="white", color="#b9b7b0", fontsize=10, width=1.7,
      label="Condição para o seguro:\npersistência do contrato\n(sai da fronteira com\nabandono de 2% a.a.)"];
  {rank=same; q1; g;}  {rank=same; q2; h;}  {rank=same; q3; bf;}
  {rank=same; q4; e;}  {rank=same; q5; cd;} {rank=same; a; ca;}
  q1 -> g  [label="  Não  "];
  q1 -> q2 [label="  Sim"];
  q2 -> h  [label="  Sociedade  "];
  q2 -> q3 [label="  Família"];
  q3 -> bf [label="  Sim  "];
  q3 -> q4 [label="  Não"];
  q4 -> e  [label="  Não  "];
  q4 -> q5 [label="  Sim"];
  q5 -> cd [label="  Sim  "];
  q5 -> a  [label="  Não"];
  a -> ca  [style=dashed, arrowhead=none, color="#b9b7b0"];
}